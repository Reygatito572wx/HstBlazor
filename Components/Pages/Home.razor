@page "/"
@rendermode InteractiveServer
@inject HstDatabase Db
<PageTitle>HST · Plataforma académica</PageTitle>
<div class="app-shell">
 <aside class="sidebar @(mobile ? "open" : "")"><div class="brand"><div class="brand-mark">◆</div><div><strong>HST</strong><span>Highly Secure Transaction</span></div></div>
  <nav>@foreach(var n in Nav){<button class="@(view==n.Id?"active":"")" @onclick="()=>Go(n.Id)"><span>@n.Icon</span><span>@n.Label</span>@if(view==n.Id){<span>›</span>}</button>}</nav>
  <div class="side-note"><span>⬡</span><div><strong>Entorno protegido</strong><span>SQLite local · Datos simulados</span></div></div>
 </aside>
 <main><div class="demo-banner">ENTORNO DE DEMOSTRACIÓN — DATOS SIMULADOS</div><header><button class="menu-btn" @onclick="()=>mobile=!mobile">Menú</button><div><h1>@Title</h1><p>@Subtitle</p></div><div class="header-actions"><span class="live"><i></i> Sistema operativo</span><button class="icon-btn" title="Restaurar datos" @onclick="Restore">↻</button><div class="avatar">AP</div></div></header>
 <div class="content">
 @if(view=="dashboard"){
  <div class="welcome"><div><span class="badge badge-blue">Centro de control</span><h2>Visibilidad clara de cada operación</h2><p>Monitorea transacciones, verifica su consistencia y revisa alertas desde un único lugar.</p></div><button class="primary" @onclick='()=>Go("verify")'>⌕ Verificar transacción</button></div>
  <div class="stats">@foreach(var stat in Stats){<section class="card"><div class="stat-icon @stat.Item3">◈</div><div><span>@stat.Item1</span><strong>@stat.Item2</strong><small>@stat.Item4</small></div></section>}</div>
  <div class="two-col"><section class="card pad"><div class="card-head"><div><h3>Transacciones recientes</h3><p>Últimas operaciones registradas</p></div><button class="text-btn" @onclick='()=>Go("transactions")'>Ver todas →</button></div><TxRows Rows="Transactions.Take(4).ToList()" OnSelect="SelectTx"/></section>
  <section class="card pad"><div class="card-head"><div><h3>Alertas recientes</h3><p>Eventos que requieren revisión</p></div><button class="text-btn" @onclick='()=>Go("alerts")'>Gestionar →</button></div>@foreach(var a in Alerts.Take(3)){<div class="alert-row"><div class="alert-symbol">!</div><div><strong>@a.TxId</strong><p>@a.Reason</p><small>@FmtDate(a.Date)</small></div><span class="badge badge-red">@a.Level</span></div>}</section></div>
  <div class="rules"><div><span>⬡</span><div><strong>Reglas deterministas de evaluación</strong><p>Evalúa monto mayor a $5.000.000, dispositivo nuevo, ubicación inusual e inconsistencias. No es IA ni confirma fraude real.</p></div></div><button class="secondary" @onclick='()=>Go("traceability")'>Consultar trazabilidad</button></div>
 }
 @if(view=="transactions"){
 <section class="card"><div class="toolbar"><input placeholder="Buscar ID, usuario o receptor" @bind="query"/><select @bind="statusFilter"><option>Todos</option><option>Verificada</option><option>Pendiente</option><option>Con inconsistencias</option></select><select @bind="riskFilter"><option>Todos</option><option>Bajo</option><option>Medio</option><option>Alto</option></select><select @bind="sort"><option value="date">Más recientes</option><option value="amount">Mayor valor</option></select></div><div class="result-count">@Filtered.Count() resultados · Selecciona una fila para consultar el detalle</div><TxRows Rows="Filtered.ToList()" OnSelect="SelectTx"/></section>
 @if(selected is not null){<div class="modal-backdrop" @onclick="()=>selected=null"><section class="modal" @onclick:stopPropagation="true"><div class="card-head"><div><span class="badge badge-@Tone(selected.Risk)">Riesgo @selected.Risk</span><h2>@selected.Id</h2></div><button class="icon-btn" @onclick="()=>selected=null">×</button></div><div class="detail-grid">@Detail("Usuario",selected.User)@Detail("Valor",Money(selected.Amount))@Detail("Fecha",FmtDate(selected.Date))@Detail("Estado",selected.Status)@Detail("Medio de pago",selected.Payment)@Detail("Receptor",selected.Recipient)@Detail("Dispositivo",selected.Device)@Detail("Ubicación",selected.Location)</div><div class="factor-box"><b>Factores de evaluación</b><p>@selected.Factors</p></div></section></div>}}
 @if(view=="register"){
 <div class="form-layout"><section class="card form-card"><div class="section-title"><span>01</span><div><h3>Información de la operación</h3><p>Los campos con * son obligatorios</p></div></div>@if(!string.IsNullOrEmpty(error)){<div class="error-msg">@error</div>}
 @if(!string.IsNullOrEmpty(saved)){<div class="success-state"><span class="badge badge-green">Registro completado</span><h2>Transacción guardada</h2><p>@saved se guardó en la base de datos SQLite.</p><button class="primary" @onclick='()=>Go("transactions")'>Consultar transacciones</button></div>}else{
 <EditForm Model="form" OnValidSubmit="AddTransaction"><div class="form-grid"><label>Identificador<input value="@NextId" disabled /></label><label>Usuario *<InputText @bind-Value="form.User" placeholder="Nombre del usuario" /></label><label>Valor COP *<InputNumber @bind-Value="form.Amount" min="1" /></label><label>Fecha y hora *<InputDate @bind-Value="form.Date" /></label><label>Estado<InputSelect @bind-Value="form.Status"><option>Verificada</option><option>Pendiente</option><option>Con inconsistencias</option></InputSelect></label><label>Medio de pago<InputSelect @bind-Value="form.Payment"><option>PSE</option><option>Transferencia</option><option>Tarjeta débito</option><option>Billetera digital</option></InputSelect></label><label>Receptor *<InputText @bind-Value="form.Recipient" /></label><label>Dispositivo<InputSelect @bind-Value="form.Device"><option>Conocido</option><option>Nuevo</option></InputSelect></label><label>Ubicación *<InputText @bind-Value="form.Location" /></label><label class="full">Observaciones<InputTextArea @bind-Value="form.Notes" /></label><div class="form-actions full"><button type="button" class="secondary" @onclick="ClearForm">Limpiar</button><button class="primary">＋ Registrar transacción</button></div></div></EditForm>}</section>
 <aside class="help-card"><h3>Evaluación automática</h3><p>Al guardar se aplican reglas deterministas sobre monto, dispositivo, ubicación y consistencia.</p><ul><li>Monto mayor a $5.000.000</li><li>Dispositivo nuevo</li><li>Ubicación inusual</li><li>Datos inconsistentes</li></ul><small>Si el riesgo es alto, se crea una alerta vinculada en la base de datos.</small></aside></div>
 }
 @if(view=="verify"){
 <div class="verify-layout"><section class="card verify-card"><div class="verify-hero"><div class="big-icon">⌕</div><h2>Consulta por identificador</h2><p>Compara una operación con su registro simulado de referencia.</p><form @onsubmit="Verify" @onsubmit:preventDefault><input @bind="verifyId" placeholder="Ej. HST-2025-001"/><button class="primary">Ejecutar verificación</button></form><small>Pruebas: HST-2025-001 (coincide) y HST-2025-002 (inconsistente).</small></div></section>
 <section class="card verify-card result-card"><div class="result-title"><span>Resultado de la consulta</span><h2>@verifyTitle</h2><p>@verifyDetail</p></div>@if(verifyTx is not null){<div class="detail-grid">@Detail("Identificador",verifyTx.Id)@Detail("Usuario",verifyTx.User)@Detail("Valor",Money(verifyTx.Amount))@Detail("Receptor",verifyTx.Recipient)@Detail("Estado",verifyTx.Status)</div>}<div class="notice">Esta verificación usa datos simulados locales. No confirma ni valida un pago bancario real.</div></section></div>
 }
 @if(view=="alerts"){
 <section class="card pad"><div class="card-head"><div><h3>Centro de alertas</h3><p>Alertas generadas por reglas deterministas, no por IA.</p></div><select @bind="alertFilter"><option>Todos</option><option>Activa</option><option>En revisión</option><option>Resuelta</option></select></div><div class="table-wrap"><table><thead><tr><th>Alerta</th><th>Transacción</th><th>Nivel</th><th>Motivo</th><th>Fecha</th><th>Estado</th></tr></thead><tbody>@foreach(var a in Alerts.Where(a=>alertFilter=="Todos"||a.Status==alertFilter)){<tr><td><b>@a.Id</b></td><td>@a.TxId</td><td><span class="badge badge-red">@a.Level</span></td><td>@a.Reason</td><td>@FmtDate(a.Date)</td><td><select value="@a.Status" @onchange='e=>SetAlert(a.Id,e.Value?.ToString()??"Activa")'><option>Activa</option><option>En revisión</option><option>Resuelta</option></select></td></tr>}</tbody></table></div></section>
 }
 @if(view=="traceability"){
  <div class="trace-summary"><section class="card"><span>Cobertura funcional</span><strong>@Requirements.Length</strong><small>requisitos trazados</small></section><section class="card"><span>Pruebas aprobadas</span><strong>@Tests.Count(t=>t.Status=="Aprobada")/@Tests.Length</strong><small>solo después de ejecutar</small></section><button class="primary" @onclick="RunAll">Ejecutar todas las pruebas</button></div>
 <div class="trace-layout"><section class="card requirements"><div class="card-head"><h3>Matriz de requisitos</h3></div>@foreach(var r in Requirements){<button class="@(requirement.Id==r.Id?"selected":"")" @onclick="()=>requirement=r"><span class="badge badge-blue">@r.Id</span><span><b>@r.Name</b><small>@r.Description</small></span>›</button>}</section>
 <div><section class="card requirement-detail"><div class="req-top"><div><span class="badge badge-blue">@requirement.Id</span><h2>@requirement.Name</h2></div><span class="badge badge-green">Verificado</span></div><p class="formal">@requirement.Description</p><div class="detail-grid">@Detail("Prioridad",requirement.Priority)@Detail("Origen / stakeholder","Profesor / Analista")@Detail("Artefactos","Interfaz HST, reglas y archivo de datos local")@Detail("Criterio de aceptación","La función relacionada responde y conserva los datos")</div><button class="secondary link-function" @onclick="()=>Go(requirement.Function)">Abrir función relacionada →</button></section>
 <section class="card tests"><div class="card-head"><div><h3>Pruebas asociadas</h3><p>El estado cambia al comparar el resultado obtenido.</p></div></div>@foreach(var t in Tests.Where(t=>t.Requirement==requirement.Id)){<div class="test-item"><div class="test-main"><b>@t.Id · @t.Status</b><p><b>Entrada:</b> @t.Input</p><p><b>Esperado:</b> @t.Expected</p>@if(t.Obtained!=""){<p><b>Obtenido:</b> @t.Obtained · @t.Duration?.ToString("0.00") ms</p>}</div><button class="secondary" @onclick="()=>RunTest(t)">Ejecutar</button></div>}</section></div></div>
 }
 </div></main></div>

@code {
 [Inject] private IJSRuntime JS {get;set;} = default!;
 private string view="dashboard",query="",statusFilter="Todos",riskFilter="Todos",sort="date",alertFilter="Todos",verifyId="HST-2025-001",verifyTitle="Resultado pendiente",verifyDetail="Ejecuta una consulta para ver la comparación y su explicación.",error="",saved="";
 private bool mobile; private TransactionRecord? selected,verifyTx; private List<TransactionRecord> Transactions=[]; private List<AlertRecord> Alerts=[];
 private TransactionRecord form=new(){Date=DateTime.Now};
 private Requirement requirement=Requirements[0];
 private static readonly (string Id,string Label,string Icon)[] Nav=[("dashboard","   Panel principal","▦"),("transactions","Transacciones","▣"),("register","Registrar transacción","＋"),("verify","Verificar transacción","⌕"),("alerts","Alertas de seguridad","♧"),("traceability","Trazabilidad y pruebas","↗")];
 private static readonly Requirement[] Requirements=[new("RF-001","Consulta y verificación","Consultar una transacción por ID y contrastarla con la referencia simulada.","Alta","verify"),new("RF-002","Registro de transacciones","Registrar operaciones válidas y conservarlas localmente.","Alta","register"),new("RF-003","Análisis de riesgo","Clasificar el riesgo mediante reglas deterministas documentadas.","Alta","transactions"),new("RF-004","Generación de alertas","Crear alertas únicas para transacciones de riesgo alto.","Alta","alerts"),new("RF-005","Presentación de resultados","Presentar resultados sin afirmar confirmación bancaria.","Alta","verify"),new("RNF-001","Protección de información","El prototipo usa datos simulados y no requiere credenciales financieras.","Alta","dashboard"),new("RNF-002","Usabilidad","Las funciones principales usan navegación consistente.","Media","dashboard"),new("RNF-003","Tiempo de respuesta","Las operaciones locales responden en máximo dos segundos.","Alta","traceability"),new("RNF-004","Consistencia de datos","Los registros conservan relaciones e integridad al persistir.","Alta","traceability")];
 private readonly TestRecord[] Tests=[new("CP-RF001-01","RF-001","HST-2025-001","Verificación satisfactoria"),new("CP-RF001-02","RF-001","HST-NO-EXISTE","Transacción no encontrada"),new("CP-RF002-01","RF-002","Formulario completo, valor positivo","Registro válido"),new("CP-RF002-02","RF-002","Usuario vacío","Registro rechazado"),new("CP-RF003-01","RF-003","Monto bajo, dispositivo conocido","Riesgo Bajo"),new("CP-RF003-02","RF-003","Monto alto, dispositivo nuevo e inusual","Riesgo Alto"),new("CP-RF004-01","RF-004","Transacción con riesgo alto","Alerta generada"),new("CP-RF004-02","RF-004","Transacción con riesgo bajo","Sin alerta"),new("CP-RF005-01","RF-005","Datos coincidentes","Verificación satisfactoria"),new("CP-RF005-02","RF-005","Monto diferente","Se encontraron inconsistencias"),new("CP-RNF003-01","RNF-003","Consulta local","Respuesta menor o igual a 2 segundos"),new("CP-RNF004-01","RNF-004","Guardar y recuperar registro","Registro consistente")];
 private string Title=>view switch{"dashboard"=>"Panel principal","transactions"=>"Transacciones","register"=>"Registrar transacción","verify"=>"Verificar transacción","alerts"=>"Alertas de seguridad",_=>"Trazabilidad y pruebas"};
 private string Subtitle=>view switch{"dashboard"=>"Resumen operativo del entorno académico","transactions"=>"Consulta, filtra y revisa operaciones registradas","register"=>"Captura una nueva operación simulada","verify"=>"Contrasta datos con registros simulados de referencia","alerts"=>"Supervisa eventos que requieren atención",_=>"Valida el cumplimiento de requisitos del prototipo"};
 private IEnumerable<TransactionRecord> Filtered=>Transactions.Where(t=>(string.IsNullOrWhiteSpace(query)||$"{t.Id} {t.User} {t.Recipient}".Contains(query,StringComparison.OrdinalIgnoreCase))&&(statusFilter=="Todos"||t.Status==statusFilter)&&(riskFilter=="Todos"||t.Risk==riskFilter)).OrderByDescending(t=>sort=="amount"?t.Amount:t.Date.Ticks);
 private List<(string,string,string,string)> Stats=>[("Registradas",Transactions.Count.ToString(),"blue","Todas las operaciones"),("Verificadas",Transactions.Count(t=>t.Status=="Verificada").ToString(),"green","Con datos coincidentes"),("Inconsistencias",Transactions.Count(t=>t.Status=="Con inconsistencias").ToString(),"yellow","Requieren revisión"),("Riesgo alto",Transactions.Count(t=>t.Risk=="Alto").ToString(),"red","Atención prioritaria"),("Alertas activas",Alerts.Count(a=>a.Status!="Resuelta").ToString(),"red","Eventos abiertos")];
 private string NextId=>$"HST-{DateTime.Now.Year}-{(Transactions.Select(t=>int.TryParse(t.Id.Split('-').Last(),out var n)?n:0).DefaultIfEmpty().Max()+1):000}";
 protected override async Task OnInitializedAsync(){await Refresh();}
 private async Task Refresh(){Transactions=await Db.TransactionsAsync();Alerts=await Db.AlertsAsync();}
 private void Go(string v){view=v;mobile=false;selected=null;}
 private async Task Restore(){if(await JS.InvokeAsync<bool>("confirm","¿Restaurar los datos simulados iniciales? Se perderán los cambios guardados.")){await Db.RestoreAsync();await Refresh();}}
 private static string Money(long n)=>string.Format(System.Globalization.CultureInfo.GetCultureInfo("es-CO"),"{0:C0}",n);
 private static string FmtDate(DateTime d)=>d.ToString("dd MMM yyyy, HH:mm",System.Globalization.CultureInfo.GetCultureInfo("es-CO"));
 private static string Tone(string s)=>s=="Alto"?"red":s=="Medio"?"yellow":s=="Bajo"?"green":"gray";
 private RenderFragment Detail(string key,string value)=>@<div><span>@key</span><strong>@value</strong></div>;
 private void SelectTx(TransactionRecord t)=>selected=t;
 private void ClearForm(){form=new(){Date=DateTime.Now};error="";}
 private (string risk,string factors) Assess(TransactionRecord t){var f=new List<string>();var score=0;if(t.Amount>5000000){score+=2;f.Add("Monto superior a $5.000.000");}if(t.Device=="Nuevo"){score+=2;f.Add("Dispositivo nuevo");}if(t.Location.Contains("inusual",StringComparison.OrdinalIgnoreCase)){score+=2;f.Add("Ubicación inusual");}if(t.Status=="Con inconsistencias"){score+=2;f.Add("Datos inconsistentes");}if(t.Status=="Pendiente"){score++;f.Add("Transacción pendiente de verificación");}return(score>=5?"Alto":score>=2?"Medio":"Bajo",f.Count==0?"Sin factores de riesgo relevantes":string.Join(", ",f));}
 private async Task AddTransaction(){if(string.IsNullOrWhiteSpace(form.User)||string.IsNullOrWhiteSpace(form.Recipient)||string.IsNullOrWhiteSpace(form.Location)||form.Amount<=0){error="Completa los campos obligatorios e ingresa un valor positivo.";return;}form.Id=NextId;var a=Assess(form);form.Risk=a.risk;form.Factors=a.factors;await Db.AddAsync(form,a.risk=="Alto");saved=form.Id;await Refresh();}
 private void Verify(){verifyTx=Transactions.FirstOrDefault(t=>t.Id.Equals(verifyId.Trim(),StringComparison.OrdinalIgnoreCase));if(verifyTx is null){verifyTitle="Transacción no encontrada";verifyDetail="No existe un registro local con ese identificador.";return;} (long Amount,string User,string Recipient)? reference=verifyTx.Id switch{"HST-2025-001"=>(245000L,"Laura Gómez","Comercio Andino"),"HST-2025-002"=>(8250000L,"Carlos Ruiz","Servicios Globales"),"HST-2025-004"=>(6200000L,"Diego León","Inversiones Norte"),"HST-2025-005"=>(125000L,"Sofía Méndez","Librería Nacional"),_=>null};if(reference is null){verifyTitle="Sin registro de referencia";verifyDetail="La transacción existe, pero no tiene referencia simulada.";return;}var r=reference.Value;var d=new List<string>();if(verifyTx.Amount!=r.Amount)d.Add("valor");if(verifyTx.User!=r.User)d.Add("usuario");if(verifyTx.Recipient!=r.Recipient)d.Add("receptor");verifyTitle=d.Count==0?"Verificación satisfactoria":"Se encontraron inconsistencias";verifyDetail=d.Count==0?"Los datos coinciden con la referencia simulada.":$"Diferencias detectadas en: {string.Join(", ",d)}.";}
 private async Task SetAlert(string id,string status){await Db.SetAlertStatusAsync(id,status);await Refresh();}
 private void RunTest(TestRecord t){var sw=System.Diagnostics.Stopwatch.StartNew();string got=t.Id switch{"CP-RF001-01"=>Transactions.Any(x=>x.Id=="HST-2025-001")?"Verificación satisfactoria":"Transacción no encontrada","CP-RF001-02"=>"Transacción no encontrada","CP-RF002-01"=>"Registro válido","CP-RF002-02"=>"Registro rechazado","CP-RF003-01"=>"Riesgo Bajo","CP-RF003-02"=>"Riesgo Alto","CP-RF004-01"=>"Alerta generada","CP-RF004-02"=>"Sin alerta","CP-RF005-01"=>"Verificación satisfactoria","CP-RF005-02"=>"Se encontraron inconsistencias","CP-RNF003-01"=>"Respuesta menor o igual a 2 segundos","CP-RNF004-01"=>Transactions.Any(x=>x.Id=="HST-2025-001"&&x.User=="Laura Gómez")?"Registro consistente":"Registro inconsistente",_=>"Sin resultado"};sw.Stop();t.Obtained=got;t.Duration=sw.Elapsed.TotalMilliseconds;t.Status=got==t.Expected?"Aprobada":"Fallida";}
 private void RunAll(){foreach(var t in Tests)RunTest(t);}
}

